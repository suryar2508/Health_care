{
  "name": "smartvital-backend",
  "version": "1.0.0",
  "description": "Backend for SmartVital healthcare management system",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "backend:dev": "cross-env NODE_ENV=development ts-node src/server.ts",
    "backend:watch": "nodemon --exec ts-node src/server.ts",
    "backend:build": "tsc",
    "backend:start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --runInBand",
    "test:setup": "powershell -File ./scripts/setup-test-env.ps1",
    "test:run": "powershell -File ./scripts/run-tests.ps1",
    "test:setup-mongodb": "powershell -File ./scripts/setup-mongodb.ps1",
    "test:verify-mongodb": "powershell -File ./scripts/verify-mongodb.ps1",
    "test:start-mongodb": "powershell -File ./scripts/start-mongodb.ps1"
  },
  "dependencies": {
    "@types/winston": "^2.4.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.3",
    "morgan": "^1.10.0",
    "react-router-dom": "^7.5.3",
    "winston": "^3.17.0",
    "cross-env": "^7.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/express-rate-limit": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/morgan": "^1.9.4",
    "@types/node": "^18.15.11",
    "nodemon": "^2.0.22",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.3",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2"
  }
}